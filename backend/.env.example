# Optional: Google Gemini API Key for AI Retention Strategy generation
GEMINI_API_KEY=
# Optional: Gemini model for /retention (default gemini-3.5-flash)
GEMINI_MODEL_NAME=

# Optional: Gmail SMTP configuration for retention email dispatch
GMAIL_SENDER=
GMAIL_APP_PASS=
DEMO_RECEIVER=

# Optional (CHURN-54): browser origins allowed to call the API, comma-separated.
# Default: https://churn-iq-frontend-five.vercel.app plus localhost:5173/4173.
# A wildcard (*) is ignored. See docs/deployment/PRODUCTION_CONFIGURATION.md.
CORS_ALLOWED_ORIGINS=
