# Production API base URL, used by `vite build` (CHURN-29).
# Moved here from src/api/churniq.js, where it was a hard-coded fallback.
# The hosting provider's VITE_API_URL environment variable, if set, overrides this.
# Public URL only: never put secrets in a VITE_* variable (they are compiled into the bundle).
VITE_API_URL=https://churniq-32r3.onrender.com
