# =============================================================================
# ChurnIQ Pro Environment Configuration Template
# Copy this file to .env and fill in your values if needed.
# =============================================================================

# Optional: Google Gemini API Key for AI Retention Strategy generation
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional: Gemini model for /retention (default gemini-3.5-flash)
GEMINI_MODEL_NAME=

# Optional: Gmail SMTP configuration for retention email dispatch
GMAIL_SENDER=
GMAIL_APP_PASS=
DEMO_RECEIVER=

# Required to enable POST /send-email (CHURN-44). Shared secret; callers send
#   Authorization: Bearer <EMAIL_API_TOKEN>
# At least 16 characters. Unset or shorter -> /send-email returns 503.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
EMAIL_API_TOKEN=
# Optional: /send-email rate limit per client IP (defaults 5 per 600 seconds)
EMAIL_RATE_LIMIT_MAX=
EMAIL_RATE_LIMIT_WINDOW_SECONDS=
